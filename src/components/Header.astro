---
import { SITE_METADATA } from '../lib/seo';
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand-link" aria-label="FIRE Calculator Home">
      <div class="flame-icon-wrap" aria-hidden="true">
        <svg class="flame-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"></path>
        </svg>
      </div>
      <div class="brand-text">
        <span class="brand-title font-display">FIRE<span class="brand-accent">Cal</span></span>
        <span class="brand-domain">fire.pawel.in</span>
      </div>
    </a>

    <nav class="nav-links" aria-label="Main Navigation">
      <a href="#calculator" class="nav-link">Calculator</a>
      <a href="#visualizer" class="nav-link">Visualizer</a>
      <a href="#fire-types" class="nav-link">FIRE Types</a>
      <a href="#guide" class="nav-link">Guide</a>
      <a href="#faq" class="nav-link">FAQ</a>
    </nav>

    <div class="header-actions">
      <div class="badge-pill local-pill" title="All calculations execute securely in your browser">
        <span class="status-dot"></span>
        <span>Local-First</span>
      </div>

      <a
        href="https://pomodoro.in"
        target="_blank"
        rel="noopener noreferrer"
        class="badge-pill timer-pill"
        title="Visit Pomodoro.in - A local-first aesthetic timer"
      >
        <span>Pomodoro.in</span>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
          <polyline points="15 3 21 3 21 9"></polyline>
          <line x1="10" y1="14" x2="21" y2="3"></line>
        </svg>
      </a>

      <a
        href={SITE_METADATA.githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="github-btn"
        aria-label="View FIRE Calculator on GitHub"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z" />
        </svg>
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    width: 100%;
    background: rgba(9, 12, 19, 0.92);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border-bottom: 1px solid var(--border-subtle);
    padding: 12px 0;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--text-primary);
  }

  .flame-icon-wrap {
    width: 38px;
    height: 38px;
    border-radius: var(--radius-md);
    background: linear-gradient(135deg, rgba(249, 115, 22, 0.25) 0%, rgba(234, 88, 12, 0.1) 100%);
    border: 1px solid rgba(249, 115, 22, 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 12px rgba(249, 115, 22, 0.3);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .brand-link:hover .flame-icon-wrap {
    transform: scale(1.06);
    box-shadow: 0 0 18px rgba(249, 115, 22, 0.5);
  }

  .flame-svg {
    width: 22px;
    height: 22px;
    stroke: #f97316;
    fill: rgba(249, 115, 22, 0.2);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .brand-title {
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #ffffff;
  }

  .brand-accent {
    color: var(--accent-fire);
  }

  .brand-domain {
    font-size: 0.725rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .nav-link {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .nav-link:hover {
    color: #ffffff;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-emerald);
    box-shadow: 0 0 8px var(--accent-emerald);
  }

  .local-pill {
    font-size: 0.75rem;
  }

  .timer-pill {
    font-size: 0.75rem;
    border-color: rgba(249, 115, 22, 0.25);
    color: #fed7aa;
  }
  .timer-pill:hover {
    border-color: rgba(249, 115, 22, 0.5);
    background: rgba(249, 115, 22, 0.1);
  }

  .github-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    transition: all 0.2s ease;
  }

  .github-btn:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    border-color: var(--border-highlight);
  }

  @media (max-width: 768px) {
    .nav-links, .timer-pill {
      display: none;
    }
  }
</style>
